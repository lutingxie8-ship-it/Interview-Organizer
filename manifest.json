{
  "manifest_version": 3,
  "name": "面经清单助手",
  "version": "0.1.0",
  "description": "从小红书面经帖子提取问题并在侧栏整理复习。",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*", "https://api.openai.com/*", "https://apihub.agnes-ai.com/*"],
  "background": {"service_worker": "src/background.js"},
  "content_scripts": [{"matches": ["https://www.xiaohongshu.com/*", "https://xiaohongshu.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "打开面经清单"},
  "side_panel": {"default_path": "src/sidepanel.html"}
}
